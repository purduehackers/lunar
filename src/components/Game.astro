---
interface Props {
  display?: boolean;
}
const { display = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>Lunar Lander</title>
    <meta name="description" content="Multiplayer lunar lander. Land your spacecraft on procedurally generated terrain. Crash and leave your grave for others to see." />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:title" content="Lunar Lander" />
    <meta property="og:description" content="Multiplayer lunar lander. Land your spacecraft — or crash trying." />
    <meta property="og:type" content="website" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <style>
      @font-face {
        font-family: "PixelHackers";
        src: url("/PixelHackers.woff2") format("woff2");
        font-display: block;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
        touch-action: none;
      }
      canvas {
        display: block;
      }
      .join-qr {
        position: fixed;
        top: max(16px, env(safe-area-inset-top));
        right: max(16px, env(safe-area-inset-right));
        z-index: 1;
        width: clamp(112px, 18vmin, 176px);
        color: #fff;
        background: #000;
        text-decoration: none;
        text-align: center;
      }
      .join-qr img {
        display: block;
        width: 100%;
        height: auto;
        background: #fff;
      }
      .join-qr span {
        display: block;
        padding: 10px 4px;
        font: 12px "PixelHackers", monospace;
      }
      .join-qr:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 4px;
      }
    </style>
  </head>
  <body>
    <canvas id="game" data-display={display ? "true" : "false"}></canvas>
    {display && (
      <a
        class="join-qr"
        href="https://lunar.purduehackers.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join Lunar Lander at lunar.purduehackers.com"
      >
        <img src="/join-qr.svg" alt="QR code linking to lunar.purduehackers.com" width="176" height="176" />
        <span>SCAN TO PLAY</span>
      </a>
    )}
    <script>
      import { startGame } from "../lib/game";

      const canvas = document.getElementById("game") as HTMLCanvasElement;
      startGame(canvas, window.location.host, { display: canvas.dataset.display === "true" });
    </script>
  </body>
</html>
